ANTHROPIC_API_KEY=sk-ant-xxxxx

# ── AI provider (chat assistant) ─────────────────────────────────────────────
# AI_PROVIDER selects the adapter: `anthropic` (legacy default) or
# `openai-compat`. Unset = anthropic; an unknown value fails fast at request
# time with HTTP 500 — it never silently falls back.
#AI_PROVIDER=anthropic

# Generic API key. Per-adapter fallbacks apply (ANTHROPIC_API_KEY below still
# wins for anthropic); openai-compat may run keyless (Ollama/LM Studio).
#AI_API_KEY=

# openai-compat base URL, `…/v1` root, no trailing slash.
# Examples: https://api.groq.com/openai/v1 · https://openrouter.ai/api/v1 ·
#           http://localhost:11434/v1
#AI_BASE_URL=https://api.openai.com/v1

# Model id. Defaults to claude-sonnet-4-20250514 for anthropic; REQUIRED for
# openai-compat (requests fail fast without it).
#AI_MODEL=

# Sampling temperature — grounded answers, pinned low on purpose.
#AI_TEMPERATURE=0.3

# Hard output cap in tokens.
#AI_MAX_OUTPUT_TOKENS=1024

# Per-IP chat rate limit (free tiers are tighter).
#AI_RATE_LIMIT_PER_MIN=15

# Conversation trim window in messages (the route's hard max stays 20).
#AI_MAX_CONTEXT_MESSAGES=8

# Knowledge-base size threshold (chars). Under it the full KB is injected into
# the system prompt (100% recall); above it the route falls back to BM25.
#AI_KB_FULL_THRESHOLD=24000

# Anthropic prompt caching on the system prompt (cached reads cost ~10%).
#AI_CACHE_SYSTEM=false

# Example swaps (all first-class):
#   Groq:       AI_PROVIDER=openai-compat  AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=llama-3.3-70b-versatile  AI_API_KEY=…
#   OpenRouter: AI_PROVIDER=openai-compat  AI_BASE_URL=https://openrouter.ai/api/v1  AI_MODEL=<model>:free  AI_API_KEY=…
#   Ollama:     AI_PROVIDER=openai-compat  AI_BASE_URL=http://localhost:11434/v1  AI_MODEL=llama3.1   (keyless)
#   OpenAI:     AI_PROVIDER=openai-compat  AI_MODEL=gpt-4o-mini  AI_API_KEY=sk-…  (default base)
#   Anthropic:  AI_PROVIDER=anthropic  ANTHROPIC_API_KEY=… (or AI_API_KEY)

# Canonical site origin for metadata, OpenGraph/Twitter images, sitemap, robots.txt.
# Falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=https://saadahmad.dev
